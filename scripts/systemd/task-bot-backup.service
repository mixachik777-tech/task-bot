[Unit]
Description=task-bot daily PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=openclaw
WorkingDirectory=/home/openclaw/workspace/task-bot
ExecStart=/home/openclaw/workspace/task-bot/scripts/backup.sh
StandardOutput=append:/home/openclaw/workspace/task-bot/backups/backup.log
StandardError=append:/home/openclaw/workspace/task-bot/backups/backup.log
