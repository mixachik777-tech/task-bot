# ─── Telegram ─────────────────────────────────────────────────────────
# Токен бота — получи у @BotFather командой /newbot.
BOT_TOKEN=

# Численный Telegram user_id админа. Узнать можно у @userinfobot.
# Без этого поля бот не стартует.
ADMIN_TG_ID=

# Эти два поля проще заполнить ПОСЛЕ первого запуска бота через
# команды /set_chat (в супергруппе) и /set_leadership_topic (в топике
# «Руководство»). На старте можно оставить пустыми — бот будет писать
# в БД, в Telegram не постит.
TASK_CHAT_ID=
LEADERSHIP_TOPIC_ID=

# ─── PostgreSQL ───────────────────────────────────────────────────────
# Координаты БД внутри docker compose. Менять только если кастомизируешь стек.
DB_HOST=postgres
DB_PORT=5432
DB_USER=taskbot
# Любая случайная строка 32+ символа. Сгенерировать: openssl rand -hex 16
DB_PASSWORD=
DB_NAME=taskbot

# ─── Redis (FSM + кеши + rate-limit) ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── AI (Gemini 2.5 Flash через Google AI Studio) ────────────────────
# Ключ с https://aistudio.google.com/app/apikey — бесплатный tier:
# 10 RPM / 250 запросов в день / 250k токенов в минуту на ВЕСЬ ключ.
# Если пусто — раздел «🤖 Спросить AI» не работает, остальное живёт.
GEMINI_API_KEY=

# Дневной лимит вопросов к AI на одного пользователя (через Redis).
# Защищает квоту ключа от исчерпания одним активным юзером.
# 0 — без лимита (только rate-limit самого Google).
AI_USER_DAILY_LIMIT=30

# ─── Прочее ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=Europe/Moscow
